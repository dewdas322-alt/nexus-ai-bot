<!DOCTYPE html>
<html lang="en" class="dark h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NEXUS AI Studio - Powerful Coding & Chat</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: { 50: '#eef2ff', 500: '#6366f1', 600: '#4f46e5', 700: '#4338ca', 900: '#312e81' },
            darkbg: '#0B0F17',
            darkcard: '#111827',
            darkborder: '#1F2937'
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Marked parser for Markdown -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <!-- Highlight.js for Syntax Highlighting -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

  <style>
    /* Custom Scrollbar Styling */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #0B0F17; }
    ::-webkit-scrollbar-thumb { background: #1F2937; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #374151; }
    .prose code { background: #1f2937; padding: 2px 6px; border-radius: 4px; color: #f3f4f6; }
    .prose pre { background: transparent; padding: 0; margin: 0; }
  </style>
</head>
<body class="bg-darkbg text-slate-100 h-full flex flex-col font-sans overflow-hidden">

  <!-- TOP AD BANNER SLOT (Header Banner) -->
  <div id="top-ad-slot" class="w-full bg-slate-900 border-b border-slate-800 py-1 px-4 text-center text-xs text-slate-400 flex items-center justify-center min-h-[50px]">
    <!-- PASTE YOUR MONETAG / ADSTERRA HEADER SCRIPT HERE -->
    <div class="border border-dashed border-slate-700 px-4 py-1 rounded text-slate-500">
      📢 Top Ad Space (Paste Banner Ad Code Here)
    </div>
  </div>

  <!-- MAIN APP WRAPPER -->
  <div class="flex-1 flex overflow-hidden">

    <!-- SIDEBAR -->
    <aside id="sidebar" class="w-72 bg-darkcard border-r border-darkborder flex flex-col transition-all duration-300 z-20 absolute md:relative inset-y-0 -translate-x-full md:translate-x-0">
      
      <!-- Brand Logo & New Chat -->
      <div class="p-4 border-b border-darkborder flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="p-2 bg-brand-600 rounded-lg text-white">
            <i data-lucide="bot" class="w-5 h-5"></i>
          </div>
          <span class="font-bold text-lg tracking-wide text-white">NEXUS <span class="text-brand-500">AI</span></span>
        </div>
        <button id="new-chat-btn" class="p-2 hover:bg-slate-800 rounded-lg text-slate-400 hover:text-white transition">
          <i data-lucide="square-pen" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Mode Selector -->
      <div class="p-4 border-b border-darkborder">
        <label class="text-xs text-slate-400 font-semibold uppercase tracking-wider block mb-2">Execution Mode</label>
        <select id="mode-select" class="w-full bg-slate-900 border border-slate-700 text-slate-200 text-sm rounded-lg p-2.5 focus:border-brand-500 outline-none">
          <option value="normal">💬 Mode 1: Normal Chat</option>
          <option value="coding">⚡ Mode 2: Pro Coding & Architecture</option>
          <option value="agentic">🚀 Mode 3: Agentic Full Expert Mode</option>
        </select>
      </div>

      <!-- Chat History List -->
      <div class="flex-1 overflow-y-auto p-3 space-y-1" id="history-list">
        <!-- Dynamic History Items Will Load Here -->
      </div>

      <!-- SIDEBAR AD SLOT -->
      <div class="p-2 border-t border-darkborder text-center bg-slate-950/50">
        <div class="text-[10px] text-slate-500 mb-1">SPONSORED</div>
        <div class="min-h-[100px] bg-slate-900/50 border border-dashed border-slate-800 rounded flex items-center justify-center text-xs text-slate-500 p-2">
          <!-- PASTE YOUR SIDEBAR AD SCRIPT HERE -->
          📌 Sidebar Native Ad Slot
        </div>
      </div>

      <!-- Settings & Status Footer -->
      <div class="p-3 border-t border-darkborder bg-slate-950 flex items-center justify-between text-xs text-slate-400">
        <button id="open-settings-btn" class="flex items-center gap-2 hover:text-white transition">
          <i data-lucide="settings" class="w-4 h-4"></i>
          <span>Settings</span>
        </button>
        <div id="cost-tracker" class="text-slate-400 font-mono">
          Est: <span class="text-emerald-400">$0.000</span>
        </div>
      </div>
    </aside>

    <!-- MAIN CHAT AREA -->
    <main class="flex-1 flex flex-col bg-darkbg relative">
      
      <!-- Mobile Header Overlay Bar -->
      <div class="md:hidden flex items-center justify-between p-3 border-b border-darkborder bg-darkcard">
        <button id="toggle-sidebar" class="p-2 rounded-lg bg-slate-800 text-slate-200">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
        <span class="font-bold text-sm">NEXUS AI Studio</span>
        <button id="toggle-preview" class="p-2 rounded-lg bg-slate-800 text-slate-200">
          <i data-lucide="code" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Messages Display Container -->
      <div id="chat-messages" class="flex-1 overflow-y-auto p-4 md:p-6 space-y-6">
        <!-- Messages rendered dynamically -->
      </div>

      <!-- BOTTOM CHAT INPUT AREA -->
      <div class="p-4 border-t border-darkborder bg-darkcard">
        <div class="max-w-4xl mx-auto flex flex-col gap-2">
          
          <div class="relative flex items-end bg-slate-900 border border-slate-700 rounded-xl focus-within:border-brand-500 p-2 transition">
            <textarea id="user-input" rows="2" placeholder="Ask anything, generate code, or request agentic builds..." class="w-full bg-transparent border-none text-slate-100 placeholder-slate-500 resize-none outline-none text-sm p-2 max-h-32"></textarea>

            <div class="flex items-center gap-2 pl-2 border-l border-slate-800">
              <button id="mic-btn" class="p-2 hover:bg-slate-800 rounded-lg text-slate-400 hover:text-white transition" title="Voice Input">
                <i data-lucide="mic" class="w-5 h-5"></i>
              </button>
              <button id="send-btn" class="p-2.5 bg-brand-600 hover:bg-brand-500 rounded-lg text-white font-medium transition shadow-lg shadow-brand-600/30">
                <i data-lucide="send" class="w-5 h-5"></i>
              </button>
            </div>
          </div>

          <div class="flex justify-between items-center text-[11px] text-slate-500 px-1">
            <span>Powered by OpenRouter AI Engines</span>
            <span>Tokens: <span id="token-counter" class="font-mono text-slate-400">0</span></span>
          </div>

        </div>
      </div>
    </main>

    <!-- HTML/CSS LIVE PREVIEW DRAWER (WORKSPACE PANEL) -->
    <div id="preview-drawer" class="hidden w-full md:w-1/2 bg-slate-900 border-l border-darkborder flex flex-col z-30 absolute md:relative right-0 inset-y-0">
      <div class="p-3 border-b border-darkborder bg-darkcard flex items-center justify-between">
        <div class="flex items-center gap-2">
          <i data-lucide="play-circle" class="w-4 h-4 text-emerald-400"></i>
          <span class="font-bold text-sm text-slate-200">Live Web Sandbox Preview</span>
        </div>
        <button id="close-preview" class="p-1 hover:bg-slate-800 rounded text-slate-400 hover:text-white">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>
      <iframe id="sandbox-frame" class="w-full flex-1 bg-white border-none"></iframe>
    </div>

  </div>

  <!-- SETTINGS MODAL -->
  <div id="settings-modal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-darkcard border border-darkborder rounded-xl w-full max-w-md p-6 space-y-4 shadow-2xl">
      <div class="flex justify-between items-center border-b border-slate-800 pb-3">
        <h3 class="font-bold text-lg text-white">API Settings</h3>
        <button id="close-settings" class="text-slate-400 hover:text-white">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <div class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">OpenRouter API Key (Optional if Backend API Proxy is Set)</label>
          <input type="password" id="api-key-input" placeholder="sk-or-v1-..." class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-sm outline-none focus:border-brand-500 text-slate-100">
          <p class="text-[11px] text-slate-500 mt-1">Saved locally in your browser storage.</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Backend Proxy URL (For Hidden API Key Setup)</label>
          <input type="text" id="proxy-url-input" placeholder="https://your-proxy.vercel.app/api/chat" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-sm outline-none focus:border-brand-500 text-slate-100">
          <p class="text-[11px] text-slate-500 mt-1">Leave empty if using direct OpenRouter Key above.</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">AI Model Selector</label>
          <select id="model-select" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-sm text-slate-200 outline-none focus:border-brand-500">
            <option value="anthropic/claude-3.5-sonnet">Claude 3.5 Sonnet (Recommended Coding)</option>
            <option value="openai/gpt-4o">GPT-4o (Strong General & Logic)</option>
            <option value="deepseek/deepseek-chat">DeepSeek V3 (Fast & Affordable)</option>
            <option value="google/gemini-2.0-flash-001">Gemini 2.0 Flash</option>
          </select>
        </div>
      </div>

      <button id="save-settings-btn" class="w-full py-2.5 bg-brand-600 hover:bg-brand-500 rounded-lg font-medium text-white transition">Save Changes</button>
    </div>
  </div>

  <!-- APPLICATION JAVASCRIPT LOGIC -->
  <script>
    // Lucide Icons Render
    lucide.createIcons();

    // App State Management
    let apiKey = localStorage.getItem('nexus_api_key') || '';
    let proxyUrl = localStorage.getItem('nexus_proxy_url') || '';
    let selectedModel = localStorage.getItem('nexus_model') || 'anthropic/claude-3.5-sonnet';
    let currentChatHistory = [];
    let promptCounter = 0;

    // DOM Elements
    const chatContainer = document.getElementById('chat-messages');
    const userInput = document.getElementById('user-input');
    const sendBtn = document.getElementById('send-btn');
    const modeSelect = document.getElementById('mode-select');
    const settingsModal = document.getElementById('settings-modal');
    const apiKeyInput = document.getElementById('api-key-input');
    const proxyUrlInput = document.getElementById('proxy-url-input');
    const modelSelect = document.getElementById('model-select');
    const previewDrawer = document.getElementById('preview-drawer');
    const sandboxFrame = document.getElementById('sandbox-frame');

    // Load Settings
    apiKeyInput.value = apiKey;
    proxyUrlInput.value = proxyUrl;
    modelSelect.value = selectedModel;

    // Mode Prompts Dictionary
    const MODE_PROMPTS = {
      normal: "You are a helpful, smart AI assistant. Answer clearly, accurately, and politely.",
      coding: "You are an expert Senior Full-Stack Software Engineer. Output pristine, production-ready code with complete syntax highlighting, step-by-step logic, clear structures, and zero fluff.",
      agentic: "You are an Autonomous AI System Architect & Lead Developer. Break down every request into an execution plan, detail architectural decisions, provide full complete codebase implementations (HTML/CSS/JS/Python), verify syntax errors, and offer actionable optimizations."
    };

    // Open/Close Settings
    document.getElementById('open-settings-btn').addEventListener('click', () => settingsModal.classList.remove('hidden'));
    document.getElementById('close-settings').addEventListener('click', () => settingsModal.classList.add('hidden'));
    
    document.getElementById('save-settings-btn').addEventListener('click', () => {
      localStorage.setItem('nexus_api_key', apiKeyInput.value.trim());
      localStorage.setItem('nexus_proxy_url', proxyUrlInput.value.trim());
      localStorage.setItem('nexus_model', modelSelect.value);
      apiKey = apiKeyInput.value.trim();
      proxyUrl = proxyUrlInput.value.trim();
      selectedModel = modelSelect.value;
      settingsModal.classList.add('hidden');
      alert('Settings Saved Successfully!');
    });

    // Mobile Sidebar & Preview Toggle
    document.getElementById('toggle-sidebar').addEventListener('click', () => {
      document.getElementById('sidebar').classList.toggle('-translate-x-full');
    });
    document.getElementById('toggle-preview').addEventListener('click', () => {
      previewDrawer.classList.toggle('hidden');
    });
    document.getElementById('close-preview').addEventListener('click', () => {
      previewDrawer.classList.add('hidden');
    });

    // Send Message Trigger
    sendBtn.addEventListener('click', handleSendMessage);
    userInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        handleSendMessage();
      }
    });

    // Ad Interstitial Trigger Simulation
    function triggerAdCheck() {
      promptCounter++;
      // Har 5 prompts ke baad Interstitial / Popunder Ad Hook
      if (promptCounter % 5 === 0) {
        console.log("Triggering Adsterra / Monetag Popunder Event...");
        // Agar aapke pas direct ad script function hai toh yahan call karein:
        // if (typeof show_popunder_ad === 'function') show_popunder_ad();
      }
    }

    async function handleSendMessage() {
      const text = userInput.value.trim();
      if (!text) return;

      if (!apiKey && !proxyUrl) {
        alert('Please configure your OpenRouter API Key or Proxy URL in Settings first!');
        settingsModal.classList.remove('hidden');
        return;
      }

      // Append User Message to UI
      appendMessage('user', text);
      userInput.value = '';

      // Prepare Messages for API
      const modeKey = modeSelect.value;
      const systemPrompt = MODE_PROMPTS[modeKey];
      
      currentChatHistory.push({ role: 'user', content: text });

      const apiMessages = [
        { role: 'system', content: systemPrompt },
        ...currentChatHistory
      ];

      // Append AI Message Placeholder
      const aiMsgElement = appendMessage('assistant', '...Thinking...');

      triggerAdCheck(); // Ad Hook Trigger

      try {
        let response;
        
        // Agar Proxy URL setup hai toh server proxy route par bhejo, varna Direct OpenRouter API call
        if (proxyUrl) {
          response = await fetch(proxyUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              model: selectedModel,
              messages: apiMessages,
              temperature: modeKey === 'agentic' ? 0.2 : 0.7
            })
          });
        } else {
          response = await fetch("https://openrouter.ai/api/v1/chat/completions", {
            method: "POST",
            headers: {
              "Authorization": `Bearer ${apiKey}`,
              "Content-Type": "application/json",
              "HTTP-Referer": window.location.href,
              "X-Title": "NEXUS AI Studio"
            },
            body: JSON.stringify({
              model: selectedModel,
              messages: apiMessages,
              stream: true
            })
          });
        }

        if (!response.ok) throw new Error(`API Error: ${response.statusText}`);

        // Stream Processing
        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let fullResponseText = '';
        aiMsgElement.innerHTML = ''; // Clear placeholder

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;

          const chunk = decoder.decode(value, { stream: true });
          const lines = chunk.split('\n').filter(line => line.trim() !== '');

          for (const line of lines) {
            if (line.startsWith('data: ')) {
              const dataStr = line.replace('data: ', '');
              if (dataStr === '[DONE]') break;
              try {
                const parsed = JSON.parse(dataStr);
                const contentChunk = parsed.choices?.[0]?.delta?.content || '';
                fullResponseText += contentChunk;
                aiMsgElement.innerHTML = marked.parse(fullResponseText);
                chatContainer.scrollTop = chatContainer.scrollHeight;
              } catch (err) {
                // Ignore parse errors on stream boundaries
              }
            }
          }
        }

        // Finalize Code Highlighting & Sandbox Live Preview Detection
        hljs.highlightAll();
        currentChatHistory.push({ role: 'assistant', content: fullResponseText });
        
        // Auto-extract HTML/CSS/JS code blocks to Live Preview Sandbox
        if (fullResponseText.includes('```html')) {
          const codeMatch = fullResponseText.match(/```html([\s\S]*?)```/);
          if (codeMatch && codeMatch[1]) {
            sandboxFrame.srcdoc = codeMatch[1];
            previewDrawer.classList.remove('hidden');
          }
        }

      } catch (err) {
        aiMsgElement.innerHTML = `<span class="text-rose-400 font-semibold">Error: ${err.message}</span>`;
      }
    }

    function appendMessage(role, content) {
      const msgWrapper = document.createElement('div');
      msgWrapper.className = `flex ${role === 'user' ? 'justify-end' : 'justify-start'}`;

      const msgBubble = document.createElement('div');
      msgBubble.className = `max-w-[85%] md:max-w-[75%] rounded-2xl p-4 text-sm leading-relaxed ${
        role === 'user' 
          ? 'bg-brand-600 text-white rounded-br-none shadow-md' 
          : 'bg-slate-800/90 text-slate-100 rounded-bl-none border border-slate-700/60 prose prose-invert'
      }`;

      msgBubble.innerHTML = role === 'user' ? content : marked.parse(content);
      msgWrapper.appendChild(msgBubble);
      chatContainer.appendChild(msgWrapper);
      chatContainer.scrollTop = chatContainer.scrollHeight;
      
      return msgBubble;
    }

    // Voice Input Setup (Speech to Text)
    const micBtn = document.getElementById('mic-btn');
    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      const recognition = new SpeechRecognition();
      recognition.continuous = false;
      recognition.interimResults = false;

      micBtn.addEventListener('click', () => {
        recognition.start();
        micBtn.classList.add('text-rose-500', 'animate-pulse');
      });

      recognition.onresult = (event) => {
        const transcript = event.results[0][0].transcript;
        userInput.value += (userInput.value ? ' ' : '') + transcript;
        micBtn.classList.remove('text-rose-500', 'animate-pulse');
      };

      recognition.onerror = () => micBtn.classList.remove('text-rose-500', 'animate-pulse');
      recognition.onend = () => micBtn.classList.remove('text-rose-500', 'animate-pulse');
    } else {
      micBtn.style.display = 'none'; // Voice not supported
    }
  </script>
</body>
</html>
